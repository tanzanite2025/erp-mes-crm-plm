# ----------------------------------------------------------------------
# XDFC ERP - Cloudflare 生产环境专用 Nginx 配置 (Full Mode)
# ----------------------------------------------------------------------
# 该文件针对 erp.tanzanite.site 进行了深度优化
# 重点：支持 Cloudflare Real-IP，识别访客真实的公网 IP。

# 1. Cloudflare 官方 IP 网段 (用于提取访客真实 IP)
# 来源: https://www.cloudflare.com/ips/
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;

# 关键：告诉 Nginx 从 Cloudflare 特有的请求头中提取真实 IP
real_ip_header CF-Connecting-IP;

# 2. HTTP (80) 强制跳转至 HTTPS
server {
    listen 80;
    server_name erp.tanzanite.site;
    return 301 https://$host$request_uri;
}

# 3. HTTPS (443) 生产环境配置
server {
    listen 443 ssl http2;
    server_name erp.tanzanite.site;

    # 允许上传大文件 (CAD/图纸)
    client_max_body_size 100M;

    # SSL 证书配置 (Cloudflare Origin CA)
    # 部署时请将证书上传至此路径
    ssl_certificate /etc/nginx/ssl/xdfc_origin.crt;
    ssl_certificate_key /etc/nginx/ssl/xdfc_origin.key;

    # SSL 协议增强
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # 静态资源根目录 (前端构建产物)
    root /var/www/erp/.deploy-runtime/frontend/current;
    index index.html;

    # 传输压缩优化
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # 前端 SPA 路由
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Vite 静态资源强缓存 (带哈希的文件)
    location ^~ /assets/ {
        root /var/www/erp/.deploy-runtime/frontend/shared;
        try_files $uri =404;
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
    }

    location = /sw.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Prometheus scrape endpoint: restrict to internal/monitoring networks only.
    location = /api/v1/system/metrics {
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        # allow <monitoring-server-ip>;
        deny all;

        proxy_pass http://localhost:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 后端 API 路由转发 (Go + Gin)
    location /api/ {
        proxy_pass http://localhost:8080; # 注意这里要与后端 Docker 映射端口一致
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        
        # 传递被 Real-IP 模块提取的真实访客 IP
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 静态资源服务：物理上传文件直接由 Nginx 承载
    location /uploads/ {
        alias /var/www/erp/server/uploads/; # 与 server/docker-compose.yml 的 ./uploads 挂载保持一致
        expires 30d;
        try_files $uri =404;
        add_header Cache-Control "public, no-transform";
        access_log off;
    }

    # 安全响应头 (Production Grade)
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    
    # 内容安全策略 (CSP) - 允许自源以及必要的外部服务 (如 Google Fonts, Cloudflare)
    # 根据实际项目接入情况进行微调
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: http://erp.tanzanite.site https://*; connect-src 'self' http://erp.tanzanite.site https://*;" always;
}
