import type { Permission } from '@/features/system-mgmt/data/role-schema'
import { sidebarData } from '@/components/layout/data/sidebar-data'

type SegmentPermission = {
  id: string
  label: string
  desc: string
}

export type RoutePermissionEntry = {
  path: string
  permissionId: string
  fallbackPermissionIds: string[]
}

type SidebarLabelSource = {
  href: string
  label: string
  groupTitle: string
}

type RouteLabelSource = {
  href: string
  label: string
}

type TabConfigModule = Record<string, unknown>

const TAB_CONFIG_MODULES = import.meta.glob('/src/features/**/{tabs,tab-config}.{ts,tsx}', {
  eager: true,
}) as Record<string, TabConfigModule>

const ROUTE_FILES = import.meta.glob('/src/routes/_authenticated/**/*.tsx')

const EXCLUDED_ROOT_SEGMENTS = new Set(['errors'])
const HIDDEN_PAGE_PATHS = new Set(['/', '/dashboard'])

function isRouteLabelSource(value: unknown): value is RouteLabelSource {
  if (typeof value !== 'object' || value === null) return false
  const candidate = value as Record<string, unknown>
  return (
    typeof candidate.href === 'string' &&
    candidate.href.startsWith('/') &&
    typeof candidate.label === 'string' &&
    candidate.label.trim().length > 0
  )
}

function collectTabLabelSources(): RouteLabelSource[] {
  const labelByPath = new Map<string, RouteLabelSource>()

  Object.values(TAB_CONFIG_MODULES).forEach((moduleExports) => {
    Object.values(moduleExports).forEach((exportedValue) => {
      if (!Array.isArray(exportedValue)) return

      exportedValue.forEach((item) => {
        if (!isRouteLabelSource(item)) return
        const normalizedHref = normalizeRouteLookupPath(item.href)
        labelByPath.set(normalizedHref, { href: normalizedHref, label: item.label })
      })
    })
  })

  return Array.from(labelByPath.values())
}

const TAB_LABEL_SOURCES = collectTabLabelSources()

const SIDEBAR_LABEL_SOURCES: SidebarLabelSource[] = sidebarData.navGroups.flatMap((group) =>
  group.items
    .filter((item): item is typeof item & { url: string } => typeof item.url === 'string')
    .map((item) => ({ href: item.url, label: item.title, groupTitle: group.title })),
)

const ROUTE_LABEL_OVERRIDES: Record<string, string> = {
  '/furnaces': '炉台资产档案中心',
}

const SEGMENT_PERMISSION_OVERRIDES: Record<string, SegmentPermission> = {
  dashboard: { id: 'menu_dashboard', label: '访问：仪表盘', desc: '允许进入系统主控台页�? },
  approval: { id: 'menu_approval', label: '访问：审批中�?, desc: '允许进入审批相关页面' },
  'basic-settings': { id: 'menu_settings', label: '访问：基础配置', desc: '允许进入基础配置模块页面' },
  engineering: { id: 'menu_engineering', label: '访问：工程管�?, desc: '允许进入工程管理模块页面' },
  'engineering-db': { id: 'menu_engineering', label: '访问：工程管�?, desc: '允许进入工程管理模块页面' },
  'equipment-tooling': { id: 'menu_equipment', label: '访问：设备工�?, desc: '允许进入设备工装模块页面' },
  experimental: { id: 'menu_quality', label: '访问：质检审计', desc: '允许进入质量与实验相关页�? },
  'finance-management': { id: 'menu_settings', label: '访问：财务配�?, desc: '允许进入财务配置相关页面' },
  furnaces: { id: 'menu_equipment', label: '访问：设备工�?, desc: '允许进入设备工装模块页面' },
  materials: { id: 'menu_engineering', label: '访问：工程管�?, desc: '允许进入工程管理模块页面' },
  personnel: { id: 'menu_org', label: '访问：人员组�?, desc: '允许进入人员组织模块页面' },
  piecework: { id: 'menu_piecework', label: '访问：计件管�?, desc: '允许进入计件管理模块页面' },
  'print-mgmt': { id: 'menu_settings', label: '访问：打印中�?, desc: '允许进入打印中心相关页面' },
  production: { id: 'menu_prod_config', label: '访问：生产配�?, desc: '允许进入生产配置与生产执行页�? },
  purchase: { id: 'menu_trading', label: '访问：购销管理', desc: '允许进入购销模块页面' },
  quality: { id: 'menu_quality', label: '访问：质检审计', desc: '允许进入质量与实验相关页�? },
  'system-management': { id: 'menu_system', label: '访问：系统管�?, desc: '允许进入系统管理模块页面' },
  trading: { id: 'menu_trading', label: '访问：购销管理', desc: '允许进入购销模块页面' },
  warehouse: { id: 'menu_warehouse', label: '访问：仓�?, desc: '允许进入仓储与库存管理页�? },
}

function normalizePath(path: string): string {
  const normalized = path.replace(/\/+/g, '/').replace(/\/$/, '')
  return normalized || '/'
}

function normalizeRouteLookupPath(path: string): string {
  if (!path) return '/'
  if (path.startsWith('/#')) return path
  return normalizePath(path)
}

function splitPath(path: string): string[] {
  return normalizePath(path).split('/').filter(Boolean)
}

const SIDEBAR_ITEM_LABEL_BY_PATH = (() => {
  const map = new Map<string, string>()
  SIDEBAR_LABEL_SOURCES.forEach((item) => {
    map.set(normalizeRouteLookupPath(item.href), item.label)
  })
  return map
})()

const SIDEBAR_GROUP_LABELS_BY_SEGMENT = (() => {
  const map = new Map<string, string[]>()

  SIDEBAR_LABEL_SOURCES.forEach((item) => {
    const segment = splitPath(item.href)[0]
    if (!segment) return

    const labels = map.get(segment) || []
    if (!labels.includes(item.groupTitle)) {
      labels.push(item.groupTitle)
      map.set(segment, labels)
    }
  })

  return map
})()

function joinDisplayLabels(labels: string[]): string {
  return labels.join(' / ')
}

function sanitizeToken(raw: string): string {
  return raw
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '_')
    .replace(/^_+|_+$/g, '')
}

function humanizeToken(token: string): string {
  return token
    .replace(/^:/, '')
    .replace(/[-_]+/g, ' ')
    .replace(/\b\w/g, (char) => char.toUpperCase())
}

function sanitizePathToPermissionSuffix(path: string): string {
  const parts = splitPath(path).map((token) => {
    if (token.startsWith(':')) {
      const dynamicToken = sanitizeToken(token.slice(1))
      return `param_${dynamicToken || 'value'}`
    }
    return sanitizeToken(token) || 'value'
  })
  return parts.join('_') || 'root'
}

function routeFilePathToRoutePath(filePath: string): string | null {
  const prefix = '/src/routes/_authenticated/'
  if (!filePath.startsWith(prefix)) return null

  const relativeWithoutExt = filePath.slice(prefix.length).replace(/\.tsx$/, '')
  if (!relativeWithoutExt) return null

  const fileParts = relativeWithoutExt.split('/').filter(Boolean)
  const basename = fileParts[fileParts.length - 1]
  if (basename === 'route') return null

  const routeTokens: string[] = []

  fileParts.forEach((part, index) => {
    const isLast = index === fileParts.length - 1
    const tokens = part.split('.').filter(Boolean)

    if (isLast && tokens.length === 1 && tokens[0] === 'index') {
      return
    }

    tokens.forEach((token) => {
      if (token === 'index' || token === 'route') return
      if (token.startsWith('_') || token.startsWith('(')) return
      if (token.startsWith('$')) {
        const dynamicName = sanitizeToken(token.slice(1))
        routeTokens.push(`:${dynamicName || 'param'}`)
        return
      }
      routeTokens.push(token)
    })
  })

  if (routeTokens.length === 0) return '/'
  if (EXCLUDED_ROOT_SEGMENTS.has(routeTokens[0])) return null
  return normalizePath(`/${routeTokens.join('/')}`)
}

function collectRoutePaths(): string[] {
  const paths = new Set<string>()
  Object.keys(ROUTE_FILES).forEach((filePath) => {
    const routePath = routeFilePathToRoutePath(filePath)
    if (routePath) paths.add(routePath)
  })
  paths.add('/')
  return Array.from(paths)
}

function getModuleSegment(routePath: string): string {
  const first = splitPath(routePath)[0]
  return first || 'dashboard'
}

function getModuleRootPath(moduleSegment: string): string {
  return `/${moduleSegment}`
}

function shouldBuildPagePermission(path: string): boolean {
  return !HIDDEN_PAGE_PATHS.has(normalizePath(path))
}

function stripModuleAccessPrefix(label: string): string {
  const separatorIndex = Math.max(label.indexOf('�?), label.indexOf(':'))
  if (separatorIndex < 0) return label.trim()
  return label.slice(separatorIndex + 1).trim()
}

const ROUTE_LABEL_BY_PATH = (() => {
  const map = new Map<string, string>()

  SIDEBAR_LABEL_SOURCES.forEach((item) => {
    map.set(normalizeRouteLookupPath(item.href), item.label)
  })

  TAB_LABEL_SOURCES.forEach((tab) => {
    map.set(normalizeRouteLookupPath(tab.href), tab.label)
  })

  Object.entries(ROUTE_LABEL_OVERRIDES).forEach(([path, label]) => {
    map.set(normalizeRouteLookupPath(path), label)
  })

  return map
})()

function getRouteDisplayLabel(path: string): string | null {
  return ROUTE_LABEL_BY_PATH.get(normalizeRouteLookupPath(path)) || null
}

function toDefaultSegmentPermission(segment: string): SegmentPermission {
  const suffix = sanitizeToken(segment) || 'unknown'
  const display = humanizeToken(segment)
  return {
    id: `menu_${suffix}`,
    label: `访问�?{display}`,
    desc: `允许进入 ${display} 模块页面`,
  }
}

function getSegmentPermission(segment: string): SegmentPermission {
  return SEGMENT_PERMISSION_OVERRIDES[segment] || toDefaultSegmentPermission(segment)
}

function resolveSegmentDisplayLabel(segment: string): string {
  const segmentPermission = getSegmentPermission(segment)
  const fallbackLabel = stripModuleAccessPrefix(segmentPermission.label)
  const rootPathLabel = SIDEBAR_ITEM_LABEL_BY_PATH.get(normalizeRouteLookupPath(`/${segment}`))
  if (rootPathLabel) return rootPathLabel

  if (!SHARED_PERMISSION_IDS.has(segmentPermission.id)) return fallbackLabel

  const groupLabels = SIDEBAR_GROUP_LABELS_BY_SEGMENT.get(segment) || []
  return groupLabels.length > 0 ? joinDisplayLabels(groupLabels) : fallbackLabel
}

function comparePathsBySpecificity(a: string, b: string): number {
  const aSegments = splitPath(a)
  const bSegments = splitPath(b)

  if (aSegments.length !== bSegments.length) {
    return bSegments.length - aSegments.length
  }

  const aStaticCount = aSegments.filter((segment) => !segment.startsWith(':')).length
  const bStaticCount = bSegments.filter((segment) => !segment.startsWith(':')).length
  if (aStaticCount !== bStaticCount) {
    return bStaticCount - aStaticCount
  }

  return b.length - a.length
}

function buildPagePermission(path: string, parentId: string): Permission {
  const permissionId =
    path === '/' ? 'page_dashboard_home' : `page_${sanitizePathToPermissionSuffix(path)}`
  const routeDisplayLabel = getRouteDisplayLabel(path)
  const moduleRootLabel = (() => {
    const segments = splitPath(path)
    if (segments.length !== 1) return null
    return resolveSegmentDisplayLabel(segments[0])
  })()
  const pageLabel = path === '/' ? routeDisplayLabel : routeDisplayLabel || moduleRootLabel

  return {
    id: permissionId,
    label: path === '/' ? '页面：仪表盘首页' : pageLabel ? `页面�?{pageLabel}` : `页面�?{path}`,
    desc: path === '/' ? '允许访问仪表盘首�? : `允许访问页面 ${path}`,
    category: 'page',
    parentId,
    path,
  }
}

function buildTabPermission(path: string, parentId: string): Permission {
  const tabLabel = getRouteDisplayLabel(path)

  return {
    id: `tab_${sanitizePathToPermissionSuffix(path)}`,
    label: tabLabel ? `TAB�?{tabLabel}` : `TAB�?{path}`,
    desc: `允许访问 TAB 页面 ${path}`,
    category: 'tab',
    parentId,
    path,
  }
}

const ROUTE_PATHS = collectRoutePaths().sort(comparePathsBySpecificity)

const MODULE_SEGMENTS = Array.from(
  new Set(ROUTE_PATHS.map((routePath) => getModuleSegment(routePath))),
).sort((a, b) => a.localeCompare(b))

const MODULE_PERMISSION_ID_BY_SEGMENT = new Map<string, string>()

const SEGMENTS_BY_PERMISSION_ID = (() => {
  const map = new Map<string, string[]>()

  MODULE_SEGMENTS.forEach((segment) => {
    const permissionId = getSegmentPermission(segment).id
    const segments = map.get(permissionId) || []
    segments.push(segment)
    map.set(permissionId, segments)
  })

  return map
})()

const SHARED_PERMISSION_IDS = new Set(
  Array.from(SEGMENTS_BY_PERMISSION_ID.entries())
    .filter(([, segments]) => segments.length > 1)
    .map(([permissionId]) => permissionId),
)

const MENU_PERMISSIONS: Permission[] = (() => {
  const byId = new Map<
    string,
    { id: string; path: string; desc: string; labels: string[]; category: 'menu' }
  >()

  MODULE_SEGMENTS.forEach((segment) => {
    const meta = getSegmentPermission(segment)
    MODULE_PERMISSION_ID_BY_SEGMENT.set(segment, meta.id)

    const displayLabel = resolveSegmentDisplayLabel(segment)
    const existing = byId.get(meta.id)
    if (existing) {
      if (!existing.labels.includes(displayLabel)) {
        existing.labels.push(displayLabel)
      }
      return
    }

    byId.set(meta.id, {
      id: meta.id,
      desc: meta.desc,
      category: 'menu',
      path: getModuleRootPath(segment),
      labels: [displayLabel],
    })
  })

  return Array.from(byId.values())
    .map((permission) => {
      const mergedLabel = joinDisplayLabels(permission.labels)
      return {
        id: permission.id,
        label: `访问�?{mergedLabel}`,
        desc:
          permission.labels.length > 1 ? `允许进入 ${mergedLabel} 相关页面` : permission.desc,
        category: 'menu' as const,
        path: permission.path,
      }
    })
    .sort((a, b) => a.id.localeCompare(b.id))
})()

const PAGE_PERMISSIONS_BY_PATH = new Map<string, Permission>()
const TAB_PERMISSIONS_BY_PATH = new Map<string, Permission>()

ROUTE_PATHS.forEach((routePath) => {
  const segments = splitPath(routePath)
  const moduleSegment = getModuleSegment(routePath)
  const modulePermissionId = MODULE_PERMISSION_ID_BY_SEGMENT.get(moduleSegment)
  if (!modulePermissionId) return

  if (segments.length <= 1) {
    if (!shouldBuildPagePermission(routePath)) return
    PAGE_PERMISSIONS_BY_PATH.set(routePath, buildPagePermission(routePath, modulePermissionId))
  }
})

ROUTE_PATHS.forEach((routePath) => {
  const segments = splitPath(routePath)
  if (segments.length <= 1) return

  const moduleSegment = getModuleSegment(routePath)
  const modulePermissionId = MODULE_PERMISSION_ID_BY_SEGMENT.get(moduleSegment)
  if (!modulePermissionId) return

  const moduleRootPath = getModuleRootPath(moduleSegment)
  const parentPagePermission = PAGE_PERMISSIONS_BY_PATH.get(moduleRootPath)
  const parentId = parentPagePermission?.id || modulePermissionId

  TAB_PERMISSIONS_BY_PATH.set(routePath, buildTabPermission(routePath, parentId))
})

const PAGE_PERMISSIONS = Array.from(PAGE_PERMISSIONS_BY_PATH.values()).sort((a, b) =>
  (a.path || a.id).localeCompare(b.path || b.id),
)

const TAB_PERMISSIONS = Array.from(TAB_PERMISSIONS_BY_PATH.values()).sort((a, b) =>
  (a.path || a.id).localeCompare(b.path || b.id),
)

export const ROUTE_PERMISSION_ENTRIES: RoutePermissionEntry[] = ROUTE_PATHS.map((routePath) => {
  const segments = splitPath(routePath)
  const moduleSegment = getModuleSegment(routePath)
  const modulePermissionId = MODULE_PERMISSION_ID_BY_SEGMENT.get(moduleSegment)

  if (!modulePermissionId) {
    return {
      path: routePath,
      permissionId: '',
      fallbackPermissionIds: [],
    }
  }

  if (segments.length <= 1) {
    const pagePermission = PAGE_PERMISSIONS_BY_PATH.get(routePath)
    const permissionId = pagePermission?.id || modulePermissionId
    const fallbackPermissionIds = [modulePermissionId].filter((id) => id !== permissionId)
    return {
      path: routePath,
      permissionId,
      fallbackPermissionIds,
    }
  }

  const tabPermission = TAB_PERMISSIONS_BY_PATH.get(routePath)
  const moduleRootPath = getModuleRootPath(moduleSegment)
  const parentPagePermissionId = PAGE_PERMISSIONS_BY_PATH.get(moduleRootPath)?.id
  const permissionId = tabPermission?.id || modulePermissionId
  const fallbackPermissionIds =
    moduleSegment === 'dashboard'
      ? []
      : [parentPagePermissionId, modulePermissionId].filter(
          (id): id is string => Boolean(id) && id !== permissionId,
        )

  return {
    path: routePath,
    permissionId,
    fallbackPermissionIds,
  }
}).filter((entry) => Boolean(entry.permissionId))

ROUTE_PERMISSION_ENTRIES.sort((a, b) => comparePathsBySpecificity(a.path, b.path))

export const ROUTE_PERMISSION_MAP: Record<string, string> = ROUTE_PERMISSION_ENTRIES.reduce(
  (acc, entry) => {
    acc[entry.path] = entry.permissionId
    return acc
  },
  {} as Record<string, string>,
)

export const ROUTE_DERIVED_PERMISSIONS: Permission[] = (() => {
  const byId = new Map<string, Permission>()
  ;[...MENU_PERMISSIONS, ...PAGE_PERMISSIONS, ...TAB_PERMISSIONS].forEach((permission) => {
    byId.set(permission.id, permission)
  })
  return Array.from(byId.values())
})()

export const ROUTE_DERIVED_MENU_PERMISSIONS: Permission[] = ROUTE_DERIVED_PERMISSIONS.filter(
  (permission) => permission.category === 'menu',
)

