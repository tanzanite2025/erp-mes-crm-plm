global:
  resolve_timeout: 5m

route:
  receiver: xdfc-webhook
  group_by: ['alertname', 'severity']
  group_wait: 10s
  group_interval: 1m
  repeat_interval: 5m

receivers:
  - name: xdfc-webhook
    webhook_configs:
      - url: https://erp.tanzanite.site/api/v1/system/alerts/webhook
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials: CHANGE_ME_ALERT_WEBHOOK_TOKEN

