global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alert_rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

scrape_configs:
  - job_name: xdfc-app
    metrics_path: /api/v1/system/metrics
    static_configs:
      - targets:
          - erp.tanzanite.site
    scheme: https
    # If your monitoring server resolves to internal IP/port, replace above with:
    # static_configs:
    #   - targets: ['10.0.0.15:8080']

