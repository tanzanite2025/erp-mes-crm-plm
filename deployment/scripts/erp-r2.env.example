# Copy to /etc/erp-backup-r2.env on the VPS and chmod 600.
# Do not commit the real file or paste real values into logs.

RESTIC_REPOSITORY=s3:https://<cloudflare-account-id>.r2.cloudflarestorage.com/tanzanite-erp-backups-prod
RESTIC_PASSWORD=<strong-random-restic-repository-password>
AWS_ACCESS_KEY_ID=<r2-s3-access-key-id>
AWS_SECRET_ACCESS_KEY=<r2-s3-secret-access-key>

# Optional overrides.
BACKUP_ROOT=/opt/backups/erp
RESTIC_CACHE_DIR=/var/cache/restic/erp-r2
RESTIC_HOST=srv1834903-erp
RESTIC_TAGS=erp,prod,hostinger
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=6
RESTIC_CHECK_READ_DATA_SUBSET=1/20
RESTIC_RESTORE_DRILL_ROOT=/opt/backups/erp-r2-restore-drills
