# =============================================================
# XDFC ERP Environment Template
# Copy to .env.local (frontend) and server/.env (backend) then fill real values.
# =============================================================

# --- Frontend Proxy ---
VITE_PROXY_TARGET=http://localhost:8081

# --- Frontend Remote Logging ---
# Enable only when a remote log ingestion endpoint is ready.
# Never hardcode production tokens into source files.
VITE_ENABLE_REMOTE_LOGGING=false
VITE_LOG_DRAIN_URL=
VITE_LOG_DRAIN_TOKEN=

# --- Database (server/.env) ---
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
DATABASE_URL=postgres://user:password@db:5432/dbname

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=change_me

# --- Security ---
JWT_SECRET=change_me_to_a_random_string
INITIAL_ADMIN_PASSWORD=change_me
TOPOLOGY_AUTH_PASSWORD=622575

# Alertmanager webhook shared secret.
# Required in production (GIN_MODE=release).
ALERT_WEBHOOK_TOKEN=change_me_for_alertmanager

# /metrics source restriction is maintained at Nginx/Cloudflare layer.
# Keep allow/deny rules in:
# - nginx.conf.template
# - server/deployment/nginx/erp.tanzanite.site.conf
# - server/deployment/nginx/internal_lb.conf

# --- CORS ---
ALLOWED_ORIGIN=https://your-domain.com

# --- Grafana ---
GF_SECURITY_ADMIN_PASSWORD=change_me

# --- Third-party API ---
EXCHANGERATE_API_KEY=your_api_key

# --- Runtime ---
GIN_MODE=release
ENABLE_SWAGGER=false
PORT=8081

# --- Container Runtime Identity (server/.env) ---
# Keep these values aligned with deploy-prod.sh so mounted runtime directories
# are prepared with the same numeric owner as the app container user.
XDFC_APP_UID=10001
XDFC_APP_GID=10001
