{
  "name": "digital-management-erp",
  "private": false,
  "version": "2.2.1",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "prepare": "node scripts/setup-git-hooks.mjs",
    "setup:git-hooks": "node scripts/setup-git-hooks.mjs",
    "dev": "node scripts/generate-route-tree.mjs && node scripts/generate-permission-contract.mjs && vite",
    "dev:server": "powershell -ExecutionPolicy Bypass -Command \"Set-Location ./server; go run main.go\"",
    "dev:server:debug": "powershell -ExecutionPolicy Bypass -Command \"Set-Location ./server; $env:PORT='18080'; $env:SEARCH_ENGINE_URL='http://127.0.0.1:18081'; $env:ALLOWED_ORIGIN='http://localhost:18080,http://localhost:5173'; go run main.go\"",
    "dev:frontend:debug": "powershell -ExecutionPolicy Bypass -Command \"$env:VITE_PROXY_TARGET='http://localhost:18080'; node scripts/generate-route-tree.mjs; node scripts/generate-permission-contract.mjs; vite\"",
    "dev:stack": "powershell -ExecutionPolicy Bypass -File ./server/dev-up.ps1",
    "dev:stack:reset-db": "powershell -ExecutionPolicy Bypass -File ./server/dev-up.ps1 -ResetDb",
    "dev:stack:full": "powershell -ExecutionPolicy Bypass -File ./server/dev-up.ps1 -FullStack",
    "dev:stack:full:reset-db": "powershell -ExecutionPolicy Bypass -File ./server/dev-up.ps1 -ResetDb -FullStack",
    "build": "node scripts/generate-route-tree.mjs && node scripts/generate-permission-contract.mjs && node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -b && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "test": "vitest run",
    "test:contracts": "vitest run src/features/authz/services/effective-permission-service.test.ts src/features/users/services/user-api.test.ts src/features/users/hooks/use-users.test.ts src/__contract__/",
    "test:wire-contracts": "vitest run src/__contract__/",
    "wire-contracts:refresh": "powershell -ExecutionPolicy Bypass -Command \"Set-Location ./server; go test ./services/ -run TestExportContractSamples -update\"",
    "gen:route-tree": "node scripts/generate-route-tree.mjs",
    "gen:auth-routes": "node scripts/generate-authenticated-route-catalog.mjs",
    "gen:permission-contract": "node scripts/generate-permission-contract.mjs",
    "verify:i18n": "node scripts/verify-i18n-parity.mjs",
    "verify:i18n:baseline": "node scripts/verify-i18n-parity.mjs --write-baseline",
    "verify:zh-cn-encoding": "node scripts/verify-zh-cn-encoding.mjs",
    "verify:permissions": "node scripts/verify-permissions.mjs",
    "verify:action-closure": "node scripts/check-action-permission-closure.mjs",
    "verify:frontend-logging": "node scripts/check-frontend-logging.mjs",
    "verify:package-manager-commands": "node scripts/check-package-manager-commands.mjs",
    "test:authz": "pnpm exec tsc --noEmit",
    "lint": "eslint .",
    "lint:logging": "pnpm run verify:frontend-logging && pnpm exec eslint src/lib/logger.ts src/lib/log-drain.ts scripts/check-frontend-logging.mjs eslint.config.js",
    "preview": "vite preview",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "knip": "knip",
    "check:conflict-409": "node scripts/check-conflict-409.mjs",
    "check:pnpm-lock": "node scripts/check-pnpm-lock-sync.mjs",
    "check:server-deploy": "node scripts/check-server-deploy-ready.mjs",
    "predeploy:check": "pnpm run check:pnpm-lock && pnpm run check:server-deploy && pnpm run verify:zh-cn-encoding"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-direction": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.141.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.11.2",
    "bwip-js": "^4.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.2",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.4.7",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-day-picker": "9.12.0",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.68.0",
    "react-markdown": "^10.0.0",
    "react-to-print": "^3.3.0",
    "react-top-loading-bar": "^3.0.2",
    "reactflow": "^11.11.4",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.2.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.1.0",
    "@playwright/test": "^1.59.1",
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@tanstack/react-router-devtools": "^1.141.2",
    "@tanstack/router-generator": "1.141.2",
    "@tanstack/router-plugin": "^1.141.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/bwip-js": "^3.2.3",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.25",
    "fast-check": "^4.8.0",
    "globals": "^16.5.0",
    "jsdom": "^29.0.2",
    "knip": "^5.73.4",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.3.0",
    "vitest": "^4.1.2"
  }
}
