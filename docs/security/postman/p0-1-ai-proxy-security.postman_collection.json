          "raw": "{\n  \"url\": \"https://api.openai.com/v1/chat/completions\",\n  \"method\": \"POST\",\n  \"headers\": {\"Authorization\": \"{{vendorAuth}}\"},\n  \"body\": {\n    \"model\": \"gpt-4o-mini\",\n    \"messages\": [\n      {\"role\": \"user\", \"content\": \"{{veryLargeText}}\"}\n    ]\n  }\n}"
        },
        "url": "{{baseUrl}}/api/v1/ai/proxy"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Expect 413 after hardening', function () { pm.expect(pm.response.code).to.eql(413); });"] } }]
    },
    {
      "name": "14 Reject header injection",
      "request": {
        "method": "POST",
        "header": [
