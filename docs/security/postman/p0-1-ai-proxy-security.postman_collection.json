        },
        "url": "{{baseUrl}}/api/v1/ai/proxy"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Expect 400 after hardening', function () { pm.expect(pm.response.code).to.eql(400); });"] } }]
    },
