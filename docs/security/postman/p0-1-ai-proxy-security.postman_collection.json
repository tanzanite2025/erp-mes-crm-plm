{
  "info": {
    "_postman_id": "8b4a0794-0f88-4ac0-b011-df9d1f9fb9d2",
    "name": "P0-1 AI Proxy Security Tests",
    "description": "Security test matrix for /api/v1/ai/proxy (P0-1 SSRF & forwarding controls).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Allow OpenAI (whitelisted)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://api.openai.com/v1/chat/completions\",\n  \"method\": \"POST\",\n  \"headers\": {\n    \"Authorization\": \"{{vendorAuth}}\"\n  },\n  \"body\": {\n    \"model\": \"gpt-4o-mini\",\n    \"messages\": [\n      {\"role\": \"user\", \"content\": \"hello\"}\n    ]\n  }\n}"
        },
        "url": "{{baseUrl}}/api/v1/ai/proxy"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status not blocked by local policy', function () { pm.expect([200,400,401,402,403,404,429,500,502]).to.include(pm.response.code); });"] } }]
    },
    {
      "name": "02 Allow Gemini (whitelisted)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key={{geminiKey}}\",\n  \"method\": \"POST\",\n  \"headers\": {\n    \"Content-Type\": \"application/json\"\n  },\n  \"body\": {\n    \"contents\": [\n      {\"role\": \"user\", \"parts\": [{\"text\": \"hello\"}]}\n    ]\n  }\n}"
        },
        "url": "{{baseUrl}}/api/v1/ai/proxy"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status not blocked by local policy', function () { pm.expect([200,400,401,402,403,404,429,500,502]).to.include(pm.response.code); });"] } }]
    },
    {
