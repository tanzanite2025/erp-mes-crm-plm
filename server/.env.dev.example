# Local-only Docker/full-stack baseline environment template.
# Copy to server/.env.dev and adjust if needed.
# This file is the production-consistent baseline for Dockerized local development.
# All local entrypoints read DEV_* ports. The launcher derives host-side URLs at runtime.

DEV_FRONTEND_PORT=18010
DEV_BACKEND_PORT=18020
DEV_SEARCH_PORT=18030
DEV_POSTGRES_PORT=18040
DEV_REDIS_PORT=18050

POSTGRES_USER=xdfc_admin
POSTGRES_PASSWORD=xdfc_local_dev_password
POSTGRES_DB=xdfc_official
DATABASE_URL=postgres://xdfc_admin:xdfc_local_dev_password@127.0.0.1:18040/xdfc_official?sslmode=disable

REDIS_PASSWORD=xdfc_local_redis_password
REDIS_URL=redis://:xdfc_local_redis_password@127.0.0.1:18050/0

JWT_SECRET=xdfc_local_dev_jwt_secret_change_me
# Required dedicated key for encrypting ERP AttendanceDevice.SecretValue at rest.
# Keep this value stable across restarts and replicas; do not reuse JWT_SECRET.
ATTENDANCE_SECRET_ENCRYPTION_KEY=xdfc_local_attendance_secret_key_change_me_32bytes
# Optional dedicated key for encrypting AI provider API keys at rest.
# If empty, the server falls back to JWT_SECRET.
AI_SECRET_ENCRYPTION_KEY=xdfc_local_ai_secret_encryption_key_change_me
INITIAL_ADMIN_PASSWORD=xdfc_local_admin_password
TOPOLOGY_AUTH_PASSWORD=622575
ALERT_WEBHOOK_TOKEN=local-alert-token

ALLOWED_ORIGIN=http://localhost:18010,http://127.0.0.1:18010,http://localhost:18020,http://127.0.0.1:18020
GIN_MODE=debug
ENABLE_SWAGGER=true
PORT=8080
SEARCH_ENGINE_URL=http://search-engine:8081
EXCHANGERATE_API_KEY=
GF_SECURITY_ADMIN_PASSWORD=admin
AI_PROXY_STREAM_TIMEOUT_MS=120000
AI_PROXY_MAX_CONCURRENT_REQUESTS=6
AI_PROXY_GLOBAL_WINDOW_CALLS=80
AI_PROXY_USER_WINDOW_CALLS=20
AI_PROXY_RATE_WINDOW_SECONDS=60
AI_PROXY_RUNNING_TTL_SECONDS=180
