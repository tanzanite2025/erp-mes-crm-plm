# Local-only Docker dev environment template.
# Copy to server/.env.dev and adjust if needed.
# This file is for local development only and must not point to production services.

POSTGRES_USER=xdfc_admin
POSTGRES_PASSWORD=xdfc_local_dev_password
POSTGRES_DB=xdfc_official
DATABASE_URL=postgres://xdfc_admin:xdfc_local_dev_password@db:5432/xdfc_official?sslmode=disable

REDIS_PASSWORD=xdfc_local_redis_password
REDIS_URL=redis://:xdfc_local_redis_password@redis:6379/0

JWT_SECRET=xdfc_local_dev_jwt_secret_change_me
INITIAL_ADMIN_PASSWORD=xdfc_local_admin_password
TOPOLOGY_AUTH_PASSWORD=622575
ALERT_WEBHOOK_TOKEN=local-alert-token

ALLOWED_ORIGIN=http://localhost:8080,http://localhost:5173
GIN_MODE=debug
EXCHANGERATE_API_KEY=local-test-key
GF_SECURITY_ADMIN_PASSWORD=admin
AI_PROXY_STREAM_TIMEOUT_MS=120000
